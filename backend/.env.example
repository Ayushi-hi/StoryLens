# Where the raw CSV files and the processed Parquet files live.
# Keep this OUTSIDE OneDrive, because the files are large.
DATA_DIR=C:/storylens-data

# AI provider: openrouter | openai | custom (any OpenAI-compatible server)
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=

# Only if AI_PROVIDER=openai:
# OPENAI_API_KEY=

# Only if AI_PROVIDER=custom (for example a local server):
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=